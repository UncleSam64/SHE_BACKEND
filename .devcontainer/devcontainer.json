{
    "name": "MSSQL Dev Container",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "sqlserver",
    "workspaceFolder": "/workspace",
    
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-azuretools.vscode-docker",
          "ms-vscode-remote.remote-containers",
          "ms-mssql.mssql"
        ],
        "settings": {
      "terminal.integrated.shell.linux": "/bin/bash"
    }
      }
    },
    "forwardPorts": [1433],
    "postCreateCommand": "sleep 15 && /opt/mssql-tools/bin/sqlcmd -S localhost -U SA -P 'Ibackend123' -i .devcontainer/init-db.sql"
  }
  